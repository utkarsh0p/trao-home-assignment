# ---- database ----
# MongoDB connection string. Local: mongodb://127.0.0.1:27017/interview-prep-kit
# Deployed: the MongoDB Atlas M0 SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit

# ---- auth ----
# Secret used to sign JWTs. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- llm ----
# Google AI Studio API key (free tier) for Gemini. https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Gemini model id used for every generation call.
GEMINI_MODEL=gemini-2.0-flash

# ---- server ----
PORT=4000
# 'production' enables the private/loopback URL block in the URL validator.
# Keep it unset or 'development' when running the batch command against localhost fixtures.
NODE_ENV=development
# Origin allowed to send credentialed CORS requests (the deployed frontend URL).
FRONTEND_ORIGIN=http://localhost:3000
