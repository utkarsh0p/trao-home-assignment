# ---------------------------------------------------------------------------
# Running the batch command? You need exactly one of these: GOOGLE_API_KEY.
#
#   npm install
#   echo "GOOGLE_API_KEY=..." > .env
#   npm run evaluate -- --input cases.json --output kits.json
#
# No database, no search key, no session secret, no other setup. Kits built without
# a search key simply record that they have no public-discussion research, which is
# the honest outcome rather than a failure. Everything else below is for running the
# web application.
#
# Running the whole app? It is a single service — `npm run build` builds the frontend
# and `npm start` serves it alongside the API on PORT.
# ---------------------------------------------------------------------------

# --- LLM --------------------------------------------------------------------
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
# Required for any generation, including the batch command.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Ceiling on in-flight model calls. Leave unset unless you know the key is paid:
# the client narrows itself to 1 automatically after repeated rate limits.
LLM_MAX_CONCURRENCY=3

# --- Web search (OPTIONAL) ---------------------------------------------------
# Two things use it:
#   - looking for public discussion of how a company interviews (brief §2)
#   - finding real videos and articles for each kind of question the kit asks
#
# Entirely optional, and NOT needed by `npm run evaluate`. With no key the pipeline
# skips both, says so plainly in the kit's notes, and everything else — crawling,
# extraction, generation, scheduling, validation — is unchanged. Neither reaches the
# network without a key, which is what keeps the batch's timing untouched.
# Nothing in the code branches on which command is running; a missing provider is
# handled like any other source that could not be reached.
#
# Free tier, no card: https://app.tavily.com
TAVILY_API_KEY=

# --- Database ---------------------------------------------------------------
# The MongoDB Atlas M0 SRV string. Required by the API, which persists users and
# kits. NOT required by `npm run evaluate`, which persists nothing and uses Mongo
# only as a fetch cache — without it the batch runs identically, just re-fetching
# pages it would otherwise have had cached.
MONGODB_URI=

# --- Auth -------------------------------------------------------------------
# Signs the httpOnly session cookie. Required in production; in development a
# throwaway default is used so the batch command runs without server-only secrets.
JWT_SECRET=

# --- Server -----------------------------------------------------------------
PORT=4000
# 'production' enables the private/loopback URL block and the secure cookie flags.
# Leave as development when running the batch against locally-served fixtures —
# the brief's own example serves company sites from http://localhost:8099/.
NODE_ENV=development
# Development only. The app deploys as a single service — Express serves the built
# frontend and the API from one origin — so CORS is mounted only when NODE_ENV is not
# production, for `npm run dev:web` on its own port. Do not set this in production.
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
# Build-time only, read by Next from frontend/.env.production (committed, and empty:
# an empty base makes every API call a relative /api/... path against the one origin).
# Override it only to point a separately-hosted frontend at a remote API, e.g.
#   NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# --- Test fixtures ----------------------------------------------------------
# Port for `npm run fixtures`, the local company sites used by cases.sample.json.
FIXTURE_PORT=8099
