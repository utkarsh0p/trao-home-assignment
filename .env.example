# --- Database ---------------------------------------------------------------
# Deployed: the MongoDB Atlas M0 SRV string.
# Required by the API. Optional for `npm run evaluate`, which uses Mongo only as a
# fetch cache and runs without it (slower on a retry, otherwise identical).
MONGODB_URI=

# --- Auth -------------------------------------------------------------------
# Signs the httpOnly session cookie. Required in production; in development a
# throwaway default is used so the batch command runs without server-only secrets.
JWT_SECRET=

# --- LLM --------------------------------------------------------------------
# Google AI Studio key. Required for any generation, including the batch command.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Max in-flight model calls. 2 on a free key, 5 on a paid one.
LLM_MAX_CONCURRENCY=5

# --- Server -----------------------------------------------------------------
PORT=4000
# 'production' enables the private/loopback URL block and the secure cookie flags.
# Leave as development when running the batch against locally-served fixtures.
NODE_ENV=development
# CORS allowlist — the deployed frontend origin.
FRONTEND_ORIGIN=http://localhost:3000
